# OutreachPilot MCP Server Environment Variables

# 1. Your API Key 
# (You need to generate this in your OutreachPilot Platform Admin or use a test workspace token)
OUTREACHPILOT_API_KEY=your_api_key_here

# 2. The API URL
# For local testing, use your localhost API. 
# For production, change this to https://api.useoutreachpilot.com/v1
OUTREACHPILOT_API_URL=http://localhost:3000/api/v1
